{
  "agent_servers": {
    "opencode": {
      "favorite_config_option_values": {
        "model": ["opencode/big-pickle"]
      },
      "type": "registry"
    }
  },
  "ui_font_weight": 500,
  "ui_font_size": 15,
  "ui_font_family": "{{ zed_ui_font_family }}",
  "buffer_font_size": 15,
  "buffer_font_family": "{{ zed_buffer_font_family }}",
  "buffer_font_weight": 500,
  "vim_mode": true,
  "prettier": {
    "allowed": true
  },
  "theme": {
    "mode": "{{ _commands_zed_theme.mode }}",
    "light": "{{ _commands_zed_theme.light }}",
    "dark": "{{ _commands_zed_theme.name }}"
  },
{% if _commands_zed_theme.icons %}
  "icon_theme": {
    "mode": "{{ _commands_zed_theme.mode }}",
    "light": "{{ _commands_zed_theme.icons['latte'] if 'latte' in _commands_zed_theme.icons else _commands_zed_theme.icons | dictsort | first | last }}",
    "dark": "{{ _commands_zed_theme.icons[theme_flavour] if theme_flavour in _commands_zed_theme.icons else _commands_zed_theme.icons | dictsort | first | last }}"
  },
{% endif %}
  "project_panel": {
    "auto_open": {
      "on_paste": false
    },
    "hide_hidden": false,
    "hide_root": false,
    "indent_guides": {
      "show": "always"
    },
    "indent_size": 24.0,
    "git_status": true,
    "folder_icons": false,
    "file_icons": true,
    "entry_spacing": "standard",
    "default_width": 241.0,
    "dock": "right"
  },
  "agent": {
    "message_editor_min_lines": 6,
    "default_profile": "ask",
    "always_allow_tool_actions": true
  },
  "languages": {
    "Python": {
      "language_servers": [
        "ruff",
        "!pylsp",
        "!python-refactoring",
        "!basedpyright",
        "!pyright"
      ],
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      },
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
        "source.fixAll.ruff": true
      }
    }
  },
  "lsp": {
    "wakatime": {
      "initialization_options": {
        "api-key": "{{ zed_wakatime_api_key | default('') }}"
      }
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "lineLength": 100,
          "lint": {
            "extendSelect": ["I"]
          }
        }
      }
    }
  }
}
