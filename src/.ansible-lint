---
# No global lint skips. Add per-task noqa comments only when a rule cannot be
# satisfied with an available Ansible module or idiom.
skip_list: []

# Vaulted cache: noqa comments do not survive encryption, and name linting of
# sealed blobs is meaningless; pytest checks its structure.
exclude_paths:
  - archive/
  - .venv/
  - .ansible/
  - inventory/group_vars/all/vault.yml
