services:
  hermes:
    image: {{ hermes_image }}
    container_name: hermes
    command:
      - gateway
      - run
    ports:
      - "127.0.0.1:18642:8642"
      - "0.0.0.0:{{ hermes_dashboard_port }}:9119"
    environment:
      HERMES_DASHBOARD: "1"
      HERMES_DASHBOARD_INSECURE: "{{ '1' if hermes_dashboard_insecure else '0' }}"
      HERMES_DASHBOARD_BASIC_AUTH_USERNAME: {{ hermes_resolved_username | to_json }}
      HERMES_DASHBOARD_BASIC_AUTH_PASSWORD: {{ hermes_resolved_password | to_json }}
      HERMES_DASHBOARD_BASIC_AUTH_SECRET: {{ hermes_resolved_secret | to_json }}
    volumes:
      - {{ (hermes_storage_dir ~ '/data:/opt/data:z') | to_json }}
      - {{ (hermes_storage_dir ~ '/browser:/opt/hermes/.playwright:z') | to_json }}
      - {{ (hermes_storage_dir ~ '/models:/opt/models:z') | to_json }}
    shm_size: 1g
    restart: unless-stopped
